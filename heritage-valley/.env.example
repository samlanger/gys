# Claude API key (or use `ant auth login`)
ANTHROPIC_API_KEY=

# Postgres connection (Supabase or any Postgres 15+). Leave empty to use the
# embedded PGlite database under storage/pgdata for local development.
DATABASE_URL=

# Where original document files are stored. Defaults to storage/files.
FILE_STORAGE_DIR=

# Pilot team allowlist: comma-separated email:role pairs.
# Roles: admin, facilitator, viewer.
PILOT_USERS=director@example.org:admin,aide@example.org:facilitator

# Secret used to sign session cookies. Use a long random string.
SESSION_SECRET=

# Public base URL used in magic links.
APP_URL=http://localhost:3000

# Local development only: skip login entirely. Ignored when NODE_ENV=production.
# AUTH_DISABLED=true
