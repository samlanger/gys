# Product name is undecided — change it here.
NEXT_PUBLIC_APP_NAME=Huddle
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign session cookies. Required in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Data backend: "demo" (local file, sample data, no credentials) or "supabase".
DATA_BACKEND=demo

# Supabase (only when DATA_BACKEND=supabase). The service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_PILOT_TZ=Europe/London
